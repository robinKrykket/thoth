{
  "manifest_version": 3,
  "name": "Thoth",
  "version": "0.2.0",
  "description": "Record a browsing session and get a replayable, human-readable report of the backend API calls (with token provenance and per-call replayability ratings).",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "debugger",
    "storage",
    "downloads",
    "tabs",
    "activeTab"
  ],

  "host_permissions": ["https://api.anthropic.com/*"],

  "options_page": "src/options/options.html",

  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Thoth",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
